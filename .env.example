# BelivrHQ backend configuration reference.
# Copy to .env and fill the required/feature-specific values.
# Non-unique defaults below are implemented in code and may be omitted from .env.

# Required connections. Production origins must be public HTTPS URLs.
WEB_URL=http://localhost:3000
PUBLIC_API_URL=
DATABASE_URL=postgresql://user:password@localhost:5433/belivrhq
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
REDIS_URL=redis://localhost:6379
# Required when REDIS_URL is an HTTPS Upstash REST endpoint.
UPSTASH_REDIS_TOKEN=

# Unique server keys: no production defaults. Keep existing keys stable.
# Required bot protection; at least 32 characters. Generate: openssl rand -hex 32
ALTCHA_HMAC_KEY=
# Required in production for pastoral encryption; at least 16 characters.
PASTORAL_ENCRYPTION_KEY=
# Required for encrypted provider accounts and backend authenticator MFA.
# Each must be 64 hexadecimal characters. Generate each separately.
INTEGRATIONS_ENCRYPTION_KEY=
TWO_FACTOR_ENCRYPTION_KEY=
# When enabled, use the same secret on web and backend; at least 32 characters.
INTERNAL_PROXY_SECRET=

# Organization subscription checkout and its distinct webhook secret hash.
# Church payment/messaging credentials are configured in Integrations.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Needed only for historical organization Paystack payments, if applicable.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Organization authentication, welcome and billing mail.
RESEND_API_KEY=
RESEND_FROM=noreply@churchos.app

# Optional paid AI. A key, model and explicit current USD rates are all required
# before enabling AI. Reference-based guidance works without them.
OPENAI_API_KEY=
ASK_BELIVRHQ_AI_ENABLED=false
ASK_BELIVRHQ_MODEL=
ASK_BELIVRHQ_INPUT_USD_PER_MILLION=
ASK_BELIVRHQ_OUTPUT_USD_PER_MILLION=
ASK_BELIVRHQ_CHURCH_DAILY_USD=0.25
ASK_BELIVRHQ_GLOBAL_DAILY_USD=2
ASK_BELIVRHQ_GLOBAL_DAILY_REQUESTS=2000

# Optional production monitoring.
SENTRY_DSN=

# Reusable runtime defaults: omit these from the active env unless overriding.
# Production hosts must supply NODE_ENV=production.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DB_POOL_MAX=10
DB_SERVERLESS_POOL_MAX=1
DB_CONNECT_TIMEOUT_MS=15000
# Automatic idle timeout: 10000ms persistent, 1000ms serverless.
# Set this only when intentionally overriding automatic selection.
# DB_IDLE_TIMEOUT_MS=10000
SUPABASE_STORAGE_BUCKET=media
SUPABASE_PRIVATE_STORAGE_BUCKET=media-private
ENABLE_SMS_FALLBACK=false
SUBSCRIPTION_PAYSTACK_CURRENCIES=NGN
SUBSCRIPTION_FLUTTERWAVE_CURRENCIES=NGN
ENABLE_SWAGGER=false
# Workers default off on serverless HTTP hosts and on for persistent processes.
# The start:worker entrypoint explicitly enables processors.
# ENABLE_QUEUE_WORKERS=tr