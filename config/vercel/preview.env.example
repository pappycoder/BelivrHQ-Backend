# Preview-only values. Actual file: .env.vercel.preview (Git-ignored).
# Set a separate staging database/Supabase project and public HTTPS origins.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
WEB_URL=
PUBLIC_API_URL=
# Redis credentials belong only to this environment.
REDIS_URL=
UPSTASH_REDIS_TOKEN=
# BullMQ TCP/TLS connection; required when REDIS_URL is HTTPS.
QUEUE_REDIS_URL=
# Preview cache/queue namespace. Match this on staging workers.
REDIS_NAMESPACE=belivrhq-preview
# Optional environment-specific credentials. Prefer provider test mode here.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=
OPENAI_API_KEY=
