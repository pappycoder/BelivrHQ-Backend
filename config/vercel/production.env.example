# Production-only values. Actual file: .env.vercel.production (Git-ignored).
# Fill from existing live settings. Do not substitute the local development origins.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
WEB_URL=
PUBLIC_API_URL=
# Redis credentials belong only to this environment.
REDIS_URL=
UPSTASH_REDIS_TOKEN=
# Leave REDIS_NAMESPACE unset to preserve existing live Redis keys and queues.
# A persistent live worker must use the same effective namespace as this API.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=
OPENAI_API_KEY=
