# Shared Preview/Production values. Actual file: .env.vercel.shared (Git-ignored).
# Existing values for these settings are copied from .env by env:vercel:init.
# No new keys are generated. Explicit empty values are uploaded as empty values.
NODE_ENV=production
ALTCHA_HMAC_KEY=
ALTCHA_HMAC_KEY_PREVIOUS_KEYS=[]
PASTORAL_ENCRYPTION_KEY=
PASTORAL_ENCRYPTION_KEY_PREVIOUS_KEYS=[]
INTEGRATIONS_ENCRYPTION_KEY=
INTEGRATIONS_ENCRYPTION_KEY_PREVIOUS_KEYS=[]
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_ENCRYPTION_KEY_PREVIOUS_KEYS=[]
INTERNAL_PROXY_SECRET=
INTERNAL_PROXY_SECRET_PREVIOUS_KEYS=[]
MEDIA_UPLOAD_SIGNING_KEY=
MEDIA_UPLOAD_SIGNING_KEY_PREVIOUS_KEYS=[]
REDIS_URL=
UPSTASH_REDIS_TOKEN=
SENTRY_DSN=
# Defaults shared by both environments may be added here.
