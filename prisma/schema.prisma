// BelivrHQ Prisma Schema
// PostgreSQL database with Supabase Auth for authentication.
// Order: client configuration, enums by feature, then models by feature.
// Model fields: identifiers, data, audit timestamps, relations, constraints.
// Enum values and compound field/index order are intentional; preserve them.

// ─── Client and database configuration ───

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URLs for Migrate are now configured in prisma.config.ts
}

// ─── Enums: Platform subscriptions ───

enum SubscriptionPlan {
  essentials
  community
  network
  enterprise
}

enum BillingCycle {
  monthly
  annual
}

enum SubscriptionPaymentStatus {
  pending
  success
  failed
  reversed
}

enum SubscriptionGateway {
  paystack
  flutterwave
}

// ─── Enums: People ───

enum MemberStatus {
  active
  inactive
  suspended
  transferred
}

// ─── Enums: Giving and payments ───

enum TransactionStatus {
  pending
  success
  failed
  reversed
}

enum TransactionType {
  digital
  cash
  bank_transfer
}

enum PaymentGateway {
  paystack
  flutterwave
  manual
}

// ─── Enums: Events and ticketing ───

enum EventType {
  service
  conference
  lifecycle
  training
  social
}

enum RegistrationPaymentStatus {
  pending
  paid
  failed
  refunded
}

enum TicketStatus {
  reserved
  paid
  cancelled
  refunded
}

// ─── Enums: Communication ───

enum MessageDirection {
  inbound
  outbound
}

// ─── Enums: Pastoral care ───

enum RiskLevel {
  low
  medium
  high
  critical
}

enum ConfidentialityLevel {
  standard
  confidential
  restricted
}

// ─── Enums: Assets and inventory ───

enum AssetStatus {
  active
  maintenance
  retired
  lost
  disposed
}

enum AssetCondition {
  new
  good
  fair
  poor
  damaged
}

enum DepreciationMethod {
  straight_line
  reducing_balance
}

enum MaintenanceStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum AssetLoanStatus {
  borrowed
  returned
  overdue
}

// ─── Enums: Forms ───

enum FormStatus {
  draft
  published
  closed
}

enum SubmissionStatus {
  pending
  approved
  rejected
}

// ─── Models: Church and branch structure ───

model Church {
  id String @id @default(uuid())

  name         String
  denomination String?
  address      String?
  city         String?
  state        String?
  country      String  @default("Nigeria")
  phone        String?
  email        String?
  website      String?
  logo_url     String?
  config       Json    @default("{}")

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  subscription                PlatformSubscription?
  branches                    Branch[]
  church_configs              ChurchConfig[]
  subscription_payments       SubscriptionPayment[]
  profiles                    Profile[]
  roles                       Role[]
  church_role_permissions     ChurchRolePermission[]
  members                     Member[]
  visitors                    Visitor[]
  families                    Family[]
  custom_field_definitions    CustomFieldDefinition[]
  intake_links                IntakeLink[]
  services                    Service[]
  attendance_sessions         AttendanceSession[]
  attendances                 Attendance[]
  giving_categories           GivingCategory[]
  transactions                Transaction[]
  events                      Event[]
  departments                 Department[]
  cell_groups                 CellGroup[]
  messages                    Message[]
  templates                   Template[]
  broadcasts                  Broadcast[]
  company_email_notifications CompanyEmailNotification[]
  integration_accounts        IntegrationAccount[]
  integration_channels        IntegrationChannel[]
  sermons                     Sermon[]
  media_assets                MediaAsset[]
  asset_categories            AssetCategory[]
  assets                      Asset[]
  forms                       Form[]
  audit_logs                  AuditLog[]

  @@map("churches")
}

model Branch {
  id        String @id @default(uuid())
  church_id String

  name            String
  is_headquarters Boolean @default(false)
  address         String?
  city            String?
  state           String?
  country         String  @default("Nigeria")
  phone           String?
  email           String?
  photo_url       String?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church              Church              @relation(fields: [church_id], references: [id])
  profiles            Profile[]
  members             Member[]
  visitors            Visitor[]
  families            Family[]
  intake_links        IntakeLink[]
  services            Service[]
  attendance_sessions AttendanceSession[]
  givingCategories    GivingCategory[]
  transactions        Transaction[]
  events              Event[]
  departments         Department[]
  cellGroups          CellGroup[]
  templates           Template[]
  sermons             Sermon[]
  mediaAssets         MediaAsset[]
  assets              Asset[]
  forms               Form[]

  @@index([church_id])
  @@map("branches")
}

model ChurchConfig {
  id        String @id @default(uuid())
  church_id String

  key   String
  value Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  church Church @relation(fields: [church_id], references: [id])

  @@unique([church_id, key])
  @@map("church_configs")
}

// ─── Models: Platform subscriptions and billing ───

// Every church requires an explicit paid subscription for workspace access.
model PlatformSubscription {
  church_id String @id

  plan              SubscriptionPlan
  cycle             BillingCycle
  paid_until        DateTime?
  period_started_at DateTime?
  scheduled_plan    SubscriptionPlan?
  scheduled_cycle   BillingCycle?
  access_grants     Json?
  enterprise_limits Json?

  created_at DateTime @default(now())

  church Church @relation(fields: [church_id], references: [id], onDelete: Cascade)

  @@map("platform_subscriptions")
}

// Immutable payment facts. The partial unique pending index is defined in SQL.
model SubscriptionPayment {
  reference               String  @id
  church_id               String
  provider_transaction_id String?

  gateway               SubscriptionGateway
  plan                  SubscriptionPlan
  cycle                 BillingCycle
  amount                Int
  currency              String                    @default("NGN")
  status                SubscriptionPaymentStatus @default(pending)
  provider_reference    String?
  lifecycle             Json?
  billing_email         String?
  pricing_snapshot      Json?
  checkout_closed_at    DateTime?
  checkout_close_reason String?
  checkout_url          String?
  intent                String                    @default("renewal")
  base_plan             SubscriptionPlan?
  base_paid_until       DateTime?
  target_paid_until     DateTime?
  application_status    String                    @default("pending")
  verified_at           DateTime?

  created_at DateTime @default(now())

  church Church @relation(fields: [church_id], references: [id], onDelete: Restrict)

  @@index([church_id, created_at])
  @@index([gateway, provider_transaction_id])
  @@index([gateway, provider_reference])
  @@map("subscription_payments")
}

model SubscriptionAlertKey {
  id         String @id
  church_id  String
  profile_id String

  resource   String
  threshold  Int
  period_end DateTime

  @@unique([church_id, profile_id, resource, threshold, period_end])
  @@map("subscription_alert_keys")
}

// ─── Models: Identity and access ───

model Profile {
  id        String  @id @default(uuid())
  church_id String
  branch_id String?
  user_id   String  @unique // Supabase Auth user ID
  member_id String? @unique

  role               String[] @default([]) // ordered by rank desc; role[0] = primary
  status             String   @default("active") // active, inactive (deactivated)
  first_name         String
  last_name          String
  email              String?
  phone              String?
  avatar_url         String?
  mfa_enabled        Boolean  @default(false)
  two_factor_enabled Boolean  @default(false) // 2FA enabled; secrets and session assurance managed by backend
  is_admin_hq        Boolean  @default(false) // HQ access override: see data from ALL branches in the church within the user's permission scope; defaulted ON for church_admin

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church            Church                @relation(fields: [church_id], references: [id])
  branch            Branch?               @relation(fields: [branch_id], references: [id])
  authenticator     ProfileAuthenticator?
  member            Member?               @relation(fields: [member_id], references: [id])
  mfa_sessions      VerifiedMfaSession[]
  assigned_visitors Visitor[]             @relation("AssignedTo")

  @@index([church_id])
  @@index([user_id])
  @@map("profiles")
}

// Server-only authenticator secrets; never returned in profile responses.
model ProfileAuthenticator {
  user_id String @id

  secret_ciphertext String
  revision          String
  last_used_step    BigInt   @default(-1)
  recovery_hashes   String[] @default([])

  created_at DateTime @default(now())

  profile Profile @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("profile_authenticators")
}

// Supabase session_id remains stable across refresh; approvals expire absolutely.
model VerifiedMfaSession {
  user_id    String
  session_id String

  revision   String
  expires_at DateTime

  profile Profile @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([user_id, session_id])
  @@index([expires_at])
  @@map("verified_mfa_sessions")
}

// Seats reserved before calling an external authentication provider.
model StaffInvitationReservation {
  id        String @id @default(uuid())
  church_id String

  email      String
  expires_at DateTime

  created_at DateTime @default(now())

  @@unique([church_id, email])
  @@index([church_id, expires_at])
  @@map("staff_invitation_reservations")
}

model Role {
  id        String  @id @default(uuid())
  church_id String? // null = global template available to all churches

  name        String
  label       String? // Human-friendly display name (custom roles); templates use frontend dictionary
  description String?

  created_at DateTime @default(now())

  church      Church?          @relation(fields: [church_id], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  @@unique([church_id, name])
  @@index([church_id])
  @@map("roles")
}

model Permission {
  id String @id @default(uuid())

  name        String  @unique
  description String?
  resource    String
  action      String // create, read, update, delete

  created_at DateTime @default(now())

  roles            RolePermission[]
  church_overrides ChurchRolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String @id @default(uuid())
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model ChurchRolePermission {
  id            String @id @default(uuid())
  church_id     String
  permission_id String

  role_name String // matches Profile.role string (e.g., "secretary")

  created_at DateTime @default(now())

  church     Church     @relation(fields: [church_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@unique([church_id, role_name, permission_id])
  @@index([church_id, role_name])
  @@map("church_role_permissions")
}

// ─── Models: People and households ───

model Member {
  id        String  @id @default(uuid())
  church_id String
  branch_id String?

  first_name      String
  last_name       String
  email           String?
  phone           String?
  whatsapp_number String?
  date_of_birth   DateTime?
  gender          String?
  address         String?
  city            String?
  state           String?
  status          MemberStatus @default(active)
  member_since    DateTime     @default(now())
  photo_url       String?
  custom_fields   Json         @default("{}")
  notes           String?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church                Church                 @relation(fields: [church_id], references: [id])
  branch                Branch?                @relation(fields: [branch_id], references: [id])
  profile               Profile?
  converted_visitors    Visitor[]
  family_members        FamilyMember[]
  attendance            Attendance[]
  transactions          Transaction[]
  recurring_giving      RecurringGiving[]
  event_registrations   EventRegistration[]
  department_members    DepartmentMember[]
  department_attendance DepartmentAttendance[]
  cell_group_members    CellGroupMember[]
  cell_group_attendance CellGroupAttendance[]
  sermon_bookmarks      SermonBookmark[]
  pastoral_notes_from   PastoralNote[]         @relation("Author")
  pastoral_notes_about  PastoralNote[]         @relation("Subject")
  life_events           LifeEvent[]
  risk_scores           RiskScore[]
  engagement_scores     EngagementScore[]
  custodian_assets      Asset[]
  asset_loans           AssetLoan[]

  @@index([church_id, branch_id, status])
  @@index([phone])
  @@index([whatsapp_number])
  @@map("members")
}

model Visitor {
  id                  String  @id @default(uuid())
  church_id           String
  branch_id           String? // Branch the visitor was first received in (derived from the recording user at create time)
  assigned_to_id      String? // Profile ID of follow-up team member
  converted_member_id String? // Member ID if converted

  first_name       String
  last_name        String?
  gender           String?
  phone            String?
  whatsapp_number  String?
  email            String?
  first_visit_date DateTime  @default(now())
  follow_up_status String    @default("new") // new, contacted, follow_up_scheduled, interested, converted, dropped_off
  notes            String?
  custom_fields    Json      @default("{}")
  converted_at     DateTime?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived
  deleted_at  DateTime? // Set when converted to a member (soft-delete)

  church              Church                @relation(fields: [church_id], references: [id])
  branch              Branch?               @relation(fields: [branch_id], references: [id])
  assigned_to         Profile?              @relation("AssignedTo", fields: [assigned_to_id], references: [id])
  converted_member    Member?               @relation(fields: [converted_member_id], references: [id])
  attendance          Attendance[]
  cellGroupAttendance CellGroupAttendance[]

  @@index([church_id, follow_up_status])
  @@index([church_id, assigned_to_id])
  @@index([branch_id])
  @@map("visitors")
}

model Family {
  id        String  @id @default(uuid())
  church_id String
  branch_id String?
  head_id   String?

  name String

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church         Church         @relation(fields: [church_id], references: [id])
  branch         Branch?        @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  family_members FamilyMember[]

  @@index([church_id, branch_id])
  @@map("families")
}

model FamilyMember {
  id        String @id @default(uuid())
  family_id String
  member_id String

  relationship String // e.g., "spouse", "child", "parent"
  is_head      Boolean @default(false)

  created_at DateTime @default(now())

  member Member @relation(fields: [member_id], references: [id])
  family Family @relation(fields: [family_id], references: [id])

  @@unique([family_id, member_id])
  @@map("family_members")
}

model CustomFieldDefinition {
  id        String @id @default(uuid())
  church_id String

  name          String
  field_type    String // text, number, date, dropdown, checkbox, textarea
  options       Json    @default("[]") // dropdown options or validation config
  is_required   Boolean @default(false)
  display_order Int     @default(0)
  is_active     Boolean @default(true)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church Church @relation(fields: [church_id], references: [id])

  @@unique([church_id, name])
  @@index([church_id])
  @@map("custom_field_definitions")
}

// ─── Models: Public people registration ───

// Branch-specific public people registration. Accepted receipts prevent repeat creation.
model IntakeLink {
  id        String @id @default(uuid())
  church_id String
  branch_id String

  kind  String
  token String @unique

  created_at DateTime @default(now())

  church      Church             @relation(fields: [church_id], references: [id], onDelete: Cascade)
  branch      Branch             @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  submissions IntakeSubmission[]

  @@unique([church_id, branch_id, kind])
  @@map("intake_links")
}

model IntakeSubmission {
  id             String  @id @default(uuid())
  church_id      String
  branch_id      String
  link_id        String
  destination_id String?

  kind        String
  data        Json
  search_text String
  status      String    @default("pending")
  reviewed_by String?
  reviewed_at DateTime?

  created_at DateTime @default(now())

  link IntakeLink @relation(fields: [link_id], references: [id], onDelete: Cascade)

  @@index([church_id, kind, status, branch_id, created_at])
  @@map("intake_submissions")
}

// ─── Models: Services and attendance ───

model Service {
  id        String  @id @default(uuid())
  church_id String
  branch_id String?

  name        String // e.g., "Sunday Service", "Wednesday Bible Study"
  category    String    @default("adult") // adult | children | mixed — mixed check-ins default to unspecified
  day_of_week Int? // 0=Sunday, 6=Saturday
  recurrence  String    @default("weekly") // weekly | one_time | multi_day
  starts_on   DateTime? @db.Date // first valid day for one_time/multi_day, optional bound for weekly
  ends_on     DateTime? @db.Date // last valid day for multi_day, optional bound for weekly
  start_time  DateTime? @db.Time(3)
  end_time    DateTime? @db.Time(3)
  is_active   Boolean   @default(true)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church              Church              @relation(fields: [church_id], references: [id])
  branch              Branch?             @relation(fields: [branch_id], references: [id])
  attendance_sessions AttendanceSession[]
  attendance          Attendance[]
  transactions        Transaction[]

  @@index([church_id, branch_id])
  @@map("services")
}

model AttendanceSession {
  id            String  @id @default(uuid())
  church_id     String
  branch_id     String
  service_id    String?
  event_id      String?
  department_id String?
  cell_group_id String?

  attendance_date DateTime @db.Date
  total           Int
  adult_count     Int?
  children_count  Int?
  male_count      Int?
  female_count    Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  church                Church                 @relation(fields: [church_id], references: [id])
  branch                Branch                 @relation(fields: [branch_id], references: [id])
  service               Service?               @relation(fields: [service_id], references: [id], onDelete: Restrict)
  event                 Event?                 @relation(fields: [event_id], references: [id], onDelete: Restrict)
  department            Department?            @relation(fields: [department_id], references: [id], onDelete: Restrict)
  cell_group            CellGroup?             @relation(fields: [cell_group_id], references: [id], onDelete: Restrict)
  attendance            Attendance[]
  department_attendance DepartmentAttendance[]
  cell_group_attendance CellGroupAttendance[]

  @@unique([service_id, branch_id, attendance_date])
  @@unique([event_id, branch_id, attendance_date])
  @@unique([department_id, branch_id, attendance_date])
  @@unique([cell_group_id, branch_id, attendance_date])
  @@index([church_id, branch_id, attendance_date])
  @@index([church_id, attendance_date])
  @@map("attendance_sessions")
}

model Attendance {
  id         String  @id @default(uuid())
  church_id  String
  service_id String?
  event_id   String?
  member_id  String?
  visitor_id String?
  session_id String?

  visitor_name    String?
  category        String   @default("adult") // adult | children | unspecified
  attendance_date DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  checkin_at      DateTime @default(now())
  source          String   @default("manual") // manual, whatsapp, qr

  created_at DateTime @default(now())

  church  Church             @relation(fields: [church_id], references: [id])
  member  Member?            @relation(fields: [member_id], references: [id])
  visitor Visitor?           @relation(fields: [visitor_id], references: [id], onDelete: SetNull)
  service Service?           @relation(fields: [service_id], references: [id])
  session AttendanceSession? @relation(fields: [session_id], references: [id], onDelete: SetNull)
  event   Event?             @relation(fields: [event_id], references: [id])

  @@unique([service_id, member_id, attendance_date]) // One check-in per recurring service date per member
  @@unique([event_id, member_id]) // One check-in per event per member
  @@unique([service_id, visitor_id, attendance_date])
  @@unique([event_id, visitor_id])
  @@index([church_id, service_id, checkin_at])
  @@index([church_id, event_id, checkin_at])
  @@index([church_id, visitor_id])
  @@index([session_id])
  @@map("attendance")
}

// ─── Models: Giving and church finance ───

// Church-wide categories: migration 20261022120000 enforces branch_id IS NULL
// and a unique (church_id, lower(trimmed name)) expression index, including archives.
model GivingCategory {
  id        String  @id @default(uuid())
  church_id String
  branch_id String?

  name          String
  description   String?
  display_order Int     @default(0)
  is_recurring  Boolean @default(false)
  is_active     Boolean @default(true)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church       Church        @relation(fields: [church_id], references: [id])
  branch       Branch?       @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([church_id, branch_id])
  @@map("giving_categories")
}

model Transaction {
  id                      String  @id @default(uuid())
  church_id               String
  branch_id               String?
  integration_account_id  String?
  member_id               String?
  category_id             String?
  service_id              String? // Optional linkage: gift recorded against a service
  event_id                String? // Optional linkage: gift recorded against an event
  provider_transaction_id String?

  amount             Float
  currency           String            @default("NGN")
  type               TransactionType   @default(digital)
  status             TransactionStatus @default(pending)
  payment_reference  String?           @unique
  payment_gateway    PaymentGateway    @default(paystack)
  provider_reference String?
  lifecycle          Json?
  payment_method     String? // card, bank, ussd, mobile_money, cash, bank_transfer
  receipt_number     String?
  receipt_url        String?
  metadata           Json              @default("{}")
  notes              String?
  giving_date        DateTime          @default(now()) @db.Date

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  church              Church              @relation(fields: [church_id], references: [id])
  branch              Branch?             @relation(fields: [branch_id], references: [id])
  member              Member?             @relation(fields: [member_id], references: [id])
  service             Service?            @relation(fields: [service_id], references: [id], onDelete: SetNull)
  category            GivingCategory?     @relation(fields: [category_id], references: [id])
  event               Event?              @relation(fields: [event_id], references: [id], onDelete: SetNull)
  integration_account IntegrationAccount? @relation(fields: [integration_account_id], references: [id], onDelete: Restrict)

  @@index([church_id, branch_id, created_at])
  @@index([church_id, branch_id, giving_date])
  @@index([church_id, member_id, giving_date])
  @@index([church_id, member_id, created_at])
  @@index([church_id, service_id])
  @@index([payment_reference])
  @@index([payment_gateway, provider_transaction_id])
  @@index([payment_gateway, provider_reference])
  @@map("transactions")
}

model RecurringGiving {
  id                     String  @id @default(uuid())
  church_id              String
  integration_account_id String?
  member_id              String
  category_id            String

  amount               Float
  currency             String    @default("NGN")
  frequency            String // weekly, monthly, quarterly
  payment_reference    String?
  authorization_code   String? // Paystack authorization code
  is_active            Boolean   @default(true)
  paused_at            DateTime?
  next_charge_date     DateTime?
  last_charge_date     DateTime?
  failed_attempt_count Int       @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  member              Member              @relation(fields: [member_id], references: [id], onDelete: Cascade)
  integration_account IntegrationAccount? @relation(fields: [integration_account_id], references: [id], onDelete: Restrict)

  @@index([church_id, member_id])
  @@map("recurring_giving")
}

// ─── Models: Events and ticketing ───

model Event {
  id        String  @id @default(uuid())
  church_id String
  branch_id String?

  title               String
  description         String?
  type                EventType @default(service)
  start_date          DateTime
  end_date            DateTime?
  recurrence          String    @default("one_time") // one_time | weekly | multi_day — weekly repeats on start_date's weekday, multi_day spans every day start_date…end_date
  location            String?
  capacity            Int?
  is_free             Boolean   @default(true)
  price               Float?
  registration_fields Json      @default("[]")

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church              Church              @relation(fields: [church_id], references: [id])
  branch              Branch?             @relation(fields: [branch_id], references: [id])
  attendance_sessions AttendanceSession[]
  attendance          Attendance[]
  transactions        Transaction[]
  ticket_tiers        EventTicketTier[]
  registrations       EventRegistration[]
  tickets             Ticket[]

  @@index([church_id, start_date])
  @@map("events")
}

model EventTicketTier {
  id       String @id @default(uuid())
  event_id String

  name          String
  price         Float
  capacity      Int?
  description   String?
  display_order Int     @default(0)

  created_at  DateTime  @default(now())
  archived_at DateTime? // Set when archived

  event Event @relation(fields: [event_id], references: [id])

  @@index([event_id])
  @@map("event_ticket_tiers")
}

model EventRegistration {
  id             String  @id @default(uuid())
  church_id      String
  event_id       String
  member_id      String
  transaction_id String?
  ticket_id      String?
  tier_id        String?

  custom_data       Json                      @default("{}")
  payment_status    RegistrationPaymentStatus @default(pending)
  payment_reference String?                   @unique
  quantity          Int                       @default(1)
  checked_in        Boolean                   @default(false)
  checked_in_at     DateTime?

  created_at DateTime @default(now())

  member Member @relation(fields: [member_id], references: [id])
  event  Event  @relation(fields: [event_id], references: [id])

  @@unique([event_id, member_id])
  @@index([church_id, event_id])
  @@map("event_registrations")
}

model Ticket {
  id              String  @id @default(uuid())
  event_id        String
  member_id       String?
  visitor_id      String?
  registration_id String? @unique
  transaction_id  String?

  code              String       @unique
  tier_name         String?
  price_paid        Float?
  payment_reference String?      @unique
  status            TicketStatus @default(reserved)
  is_used           Boolean      @default(false)
  used_at           DateTime?

  created_at DateTime @default(now())

  event Event @relation(fields: [event_id], references: [id])

  @@index([event_id])
  @@index([visitor_id])
  @@map("tickets")
}

// ─── Models: Departments and cell groups ───

model Department {
  id             String  @id @default(uuid())
  church_id      String
  branch_id      String?
  parent_id      String?
  head_member_id String? // Free-form head member id (mirrors CellGroup.leader_id)

  name        String
  description String?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church              Church                 @relation(fields: [church_id], references: [id])
  branch              Branch?                @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  attendance_sessions AttendanceSession[]
  department_members  DepartmentMember[]
  attendance          DepartmentAttendance[]
  assets              Asset[]

  @@index([church_id])
  @@index([church_id, branch_id])
  @@index([head_member_id])
  @@map("departments")
}

model DepartmentMember {
  id            String @id @default(uuid())
  department_id String
  member_id     String

  role      String   @default("member")
  joined_at DateTime @default(now())

  member     Member     @relation(fields: [member_id], references: [id])
  department Department @relation(fields: [department_id], references: [id])

  @@unique([department_id, member_id])
  @@map("department_members")
}

model DepartmentAttendance {
  id            String  @id @default(uuid())
  department_id String
  member_id     String?
  session_id    String?

  visitor_name String?
  meeting_date DateTime @db.Date
  status       String   @default("present")
  notes        String?

  created_at DateTime @default(now())

  member     Member?            @relation(fields: [member_id], references: [id], onDelete: Cascade)
  session    AttendanceSession? @relation(fields: [session_id], references: [id], onDelete: SetNull)
  department Department         @relation(fields: [department_id], references: [id], onDelete: Cascade)

  @@unique([department_id, member_id, meeting_date])
  @@index([department_id, meeting_date])
  @@index([session_id])
  @@map("department_attendance")
}

model CellGroup {
  id        String  @id @default(uuid())
  church_id String
  branch_id String?
  leader_id String?

  name         String
  address      String?
  latitude     Float?
  longitude    Float?
  meeting_day  String?
  meeting_time String?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church              Church                @relation(fields: [church_id], references: [id])
  branch              Branch?               @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  attendance_sessions AttendanceSession[]
  members             CellGroupMember[]
  attendance          CellGroupAttendance[]

  @@index([church_id])
  @@index([church_id, branch_id])
  @@map("cell_groups")
}

model CellGroupMember {
  id            String @id @default(uuid())
  cell_group_id String
  member_id     String

  role      String   @default("member") // member, leader, assistant
  joined_at DateTime @default(now())

  member     Member    @relation(fields: [member_id], references: [id])
  cell_group CellGroup @relation(fields: [cell_group_id], references: [id], onDelete: Cascade)

  @@unique([cell_group_id, member_id])
  @@index([cell_group_id])
  @@index([member_id])
  @@map("cell_group_members")
}

model CellGroupAttendance {
  id            String  @id @default(uuid())
  cell_group_id String
  member_id     String?
  visitor_id    String?
  session_id    String?

  visitor_name String?
  meeting_date DateTime @default(now())
  status       String   @default("present") // present, absent, excused
  notes        String?

  created_at DateTime @default(now())

  member     Member?            @relation(fields: [member_id], references: [id])
  visitor    Visitor?           @relation(fields: [visitor_id], references: [id], onDelete: SetNull)
  session    AttendanceSession? @relation(fields: [session_id], references: [id], onDelete: SetNull)
  cell_group CellGroup          @relation(fields: [cell_group_id], references: [id], onDelete: Cascade)

  @@unique([cell_group_id, member_id, meeting_date])
  @@unique([cell_group_id, visitor_id, meeting_date])
  @@index([cell_group_id])
  @@index([cell_group_id, meeting_date])
  @@index([cell_group_id, visitor_id])
  @@index([session_id])
  @@map("cell_group_attendance")
}

// ─── Models: Communication and notifications ───

model Message {
  id                String  @id @default(uuid())
  church_id         String
  member_id         String?
  parent_message_id String? // ID of original message when this is a fallback

  phone            String
  direction        MessageDirection
  channel          String // whatsapp, sms, email
  fallback_channel String? // sms, email, etc.
  content          String?
  media_url        String?
  status           String           @default("sent") // sent, delivered, read, failed
  metadata         Json             @default("{}")

  created_at DateTime @default(now())

  church Church @relation(fields: [church_id], references: [id])

  @@index([church_id, channel, created_at])
  @@index([parent_message_id])
  @@map("messages")
}

model Template {
  id          String  @id @default(uuid())
  church_id   String
  branch_id   String?
  external_id String? // WhatsApp template namespace/name

  name            String
  content         String
  channel         String // whatsapp, sms, email
  language        String  @default("en")
  status          String  @default("draft") // draft, published, archived
  // WhatsApp-specific template fields
  category        String? // MARKETING, UTILITY, AUTHENTICATION (WhatsApp only)
  variables       Json    @default("[]") // array of variable names for interpolation
  external_status String? // APPROVED, PENDING, REJECTED

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church     Church      @relation(fields: [church_id], references: [id])
  branch     Branch?     @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  broadcasts Broadcast[]

  @@index([church_id, branch_id])
  @@index([church_id, channel, status])
  @@map("templates")
}

model Broadcast {
  id          String @id @default(uuid())
  church_id   String
  template_id String

  name             String
  channel          String // whatsapp, sms, email
  audience_filter  Json      @default("{}")
  status           String    @default("draft") // draft, scheduled, sending, sent, cancelled, failed
  scheduled_at     DateTime?
  sent_at          DateTime?
  total_recipients Int       @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  church     Church               @relation(fields: [church_id], references: [id])
  template   Template             @relation(fields: [template_id], references: [id])
  recipients BroadcastRecipient[]

  @@index([church_id, status])
  @@index([church_id, scheduled_at])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id           String  @id @default(uuid())
  broadcast_id String
  member_id    String?

  phone   String
  status  String    @default("pending") // pending, sent, failed
  sent_at DateTime?
  error   String?

  created_at DateTime @default(now())

  broadcast Broadcast @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)

  @@index([broadcast_id])
  @@index([broadcast_id, status])
  @@map("broadcast_recipients")
}

// Internal inbox body. Recipient copies live in EmailRecipient.
model EmailMessage {
  id          String  @id @default(uuid())
  church_id   String
  sender_id   String // sender Profile.id
  reply_to_id String? // reply threading

  sender_name String? // denormalized for list display
  subject     String
  body        String

  created_at DateTime  @default(now())
  deleted_at DateTime? // set when the sender trashes their Sent copy

  recipients EmailRecipient[]

  @@index([church_id, created_at])
  @@map("email_messages")
}

model EmailRecipient {
  id         String @id @default(uuid())
  message_id String
  profile_id String // recipient Profile.id

  read_at DateTime?

  created_at DateTime  @default(now())
  deleted_at DateTime? // set when the recipient trashes their Inbox copy

  message EmailMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@index([profile_id, read_at])
  @@index([message_id])
  @@map("email_recipients")
}

// Server-only, durable organization account mail. No church email integration required.
model CompanyEmailNotification {
  id          String  @id @default(uuid())
  church_id   String
  provider_id String?

  event_key        String    @unique
  kind             String
  to_email         String
  from_email       String
  subject          String
  html             String
  text             String
  status           String    @default("pending")
  attempts         Int       @default(0)
  available_at     DateTime  @default(now())
  lease_token      String?
  lease_until      DateTime?
  first_attempt_at DateTime?
  sent_at          DateTime?
  last_error       String?

  created_at DateTime @default(now())

  church Church @relation(fields: [church_id], references: [id], onDelete: Cascade)

  @@index([status, available_at])
  @@map("company_email_notifications")
}

model Notification {
  id         String @id @default(uuid())
  church_id  String
  profile_id String

  type    String // system, attendance, giving, event, pastoral, broadcast
  title   String
  body    String
  data    Json?
  read_at DateTime?

  created_at DateTime @default(now())

  @@index([church_id, profile_id, read_at])
  @@index([church_id, profile_id, created_at])
  @@map("notifications")
}

// ─── Models: Provider accounts and channel routing ───

// Immutable encrypted credential versions; historical payments retain their account.
model IntegrationAccount {
  id        String @id @default(uuid())
  church_id String

  provider            String
  label               String
  ciphertext          String
  verification_status String    @default("unchecked")
  verified_at         DateTime?

  created_at  DateTime  @default(now())
  archived_at DateTime?

  church       Church               @relation(fields: [church_id], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurring    RecurringGiving[]
  channels     IntegrationChannel[]

  @@index([church_id, provider])
  @@map("integration_accounts")
}

model IntegrationChannel {
  church_id  String
  account_id String?

  channel  String
  mode     String  @default("disabled")
  provider String?
  settings Json    @default("{}")

  updated_at DateTime @updatedAt

  church  Church              @relation(fields: [church_id], references: [id], onDelete: Cascade)
  account IntegrationAccount? @relation(fields: [account_id], references: [id], onDelete: Restrict)

  @@id([church_id, channel])
  @@map("integration_channels")
}

// ─── Models: Media and sermons ───

model Sermon {
  id        String  @id @default(uuid())
  church_id String
  branch_id String?

  title               String
  speaker             String?
  sermon_date         DateTime
  scripture_reference String?
  series_name         String?
  tags                String[]
  audio_url           String?
  video_url           String?
  duration_seconds    Int?
  description         String?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church    Church           @relation(fields: [church_id], references: [id])
  branch    Branch?          @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  bookmarks SermonBookmark[]

  @@index([church_id, sermon_date])
  @@map("sermons")
}

model SermonBookmark {
  id        String @id @default(uuid())
  church_id String
  member_id String
  sermon_id String

  created_at DateTime @default(now())

  member Member @relation(fields: [member_id], references: [id], onDelete: Cascade)
  sermon Sermon @relation(fields: [sermon_id], references: [id], onDelete: Cascade)

  @@unique([member_id, sermon_id])
  @@index([church_id, member_id])
  @@index([member_id])
  @@index([sermon_id])
  @@map("sermon_bookmarks")
}

model MediaAsset {
  id                  String  @id @default(uuid())
  church_id           String
  branch_id           String?
  uploaded_by_user_id String?

  storage_path   String?
  storage_bucket String?
  filename       String
  url            String
  mime_type      String
  size_bytes     Int
  folder         String  @default("general")
  permissions    String  @default("members") // public, members, leadership

  created_at DateTime @default(now())

  church Church  @relation(fields: [church_id], references: [id])
  branch Branch? @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@index([church_id, branch_id, folder])
  @@map("media_assets")
}

// ─── Models: Pastoral care ───

model PastoralNote {
  id        String @id @default(uuid())
  church_id String
  member_id String
  author_id String

  content         String // Encrypted at application level
  confidentiality ConfidentialityLevel @default(standard)
  tags            String[]

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  member Member @relation("Subject", fields: [member_id], references: [id])
  author Member @relation("Author", fields: [author_id], references: [id])

  @@index([church_id, member_id])
  @@map("pastoral_notes")
}

model LifeEvent {
  id        String @id @default(uuid())
  church_id String
  member_id String

  type     String // birthday, wedding, death, dedication, baptism
  date     DateTime
  details  Json     @default("{}")
  notified Boolean  @default(false)

  created_at  DateTime  @default(now())
  archived_at DateTime? // Set when archived

  member Member @relation(fields: [member_id], references: [id])

  @@index([church_id, member_id, type])
  @@map("life_events")
}

model RiskScore {
  id        String @id @default(uuid())
  church_id String
  member_id String

  score         Int // 0-100
  level         RiskLevel
  factors       Json      @default("{}")
  calculated_at DateTime  @default(now())

  member Member @relation(fields: [member_id], references: [id])

  @@unique([member_id])
  @@index([church_id, level])
  @@map("risk_scores")
}

model EngagementScore {
  id        String @id @default(uuid())
  church_id String
  member_id String

  score         Int // 0-100
  factors       Json     @default("{}")
  calculated_at DateTime @default(now())

  member Member @relation(fields: [member_id], references: [id])

  @@unique([member_id])
  @@index([church_id])
  @@map("engagement_scores")
}

// Staff-to-pastor appointments; authorization and branch scope are service-enforced.
model Appointment {
  id         String  @id @default(uuid())
  church_id  String
  branch_id  String? // resolved birth context (the With pastor's branch)
  pastor_id  String // With party — pastor Profile.id (branch_pastor | church_admin | senior_pastor)
  person_id  String // Who party — person Profile.id (any staff/member)
  visitor_id String? // Who party when it's a visitor (null for profile Who)

  title        String
  scheduled_at DateTime
  location     String?
  notes        String?
  status       String   @default("pending") // pending, confirmed, completed, cancelled

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // set when archived

  @@index([church_id, scheduled_at])
  @@index([person_id])
  @@index([pastor_id])
  @@index([visitor_id])
  @@map("appointments")
}

// ─── Models: Assets and inventory ───

model AssetCategory {
  id        String @id @default(uuid())
  church_id String

  name        String
  description String?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church Church  @relation(fields: [church_id], references: [id])
  assets Asset[]

  @@unique([church_id, name])
  @@index([church_id])
  @@map("asset_categories")
}

model Asset {
  id            String  @id @default(uuid())
  church_id     String
  branch_id     String?
  category_id   String?
  department_id String?
  custodian_id  String?

  asset_tag           String
  name                String
  description         String?
  image_url           String?
  serial_number       String?
  brand               String?
  model               String?
  condition           AssetCondition     @default(good)
  status              AssetStatus        @default(active)
  purchase_date       DateTime?
  purchase_price      Float?
  salvage_value       Float              @default(0)
  useful_life_years   Int?
  depreciation_method DepreciationMethod @default(straight_line)
  current_value       Float?
  location            String?
  qr_code             String?
  notes               String?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church       Church              @relation(fields: [church_id], references: [id])
  branch       Branch?             @relation(fields: [branch_id], references: [id])
  custodian    Member?             @relation(fields: [custodian_id], references: [id])
  department   Department?         @relation(fields: [department_id], references: [id])
  category     AssetCategory?      @relation(fields: [category_id], references: [id])
  maintenance  AssetMaintenance[]
  depreciation AssetDepreciation[]
  loans        AssetLoan[]
  scan_logs    AssetScanLog[]

  @@unique([church_id, asset_tag])
  @@index([church_id, branch_id, created_at])
  @@index([church_id])
  @@index([church_id, status])
  @@index([church_id, category_id])
  @@index([church_id, asset_tag])
  @@map("assets")
}

model AssetMaintenance {
  id       String @id @default(uuid())
  asset_id String

  type           String
  description    String?
  status         MaintenanceStatus @default(scheduled)
  scheduled_date DateTime
  completed_date DateTime?
  cost           Float?
  performed_by   String?
  notes          String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  asset Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([asset_id])
  @@index([asset_id, status])
  @@index([asset_id, scheduled_date])
  @@map("asset_maintenance")
}

model AssetDepreciation {
  id       String @id @default(uuid())
  asset_id String

  year                Int
  opening_value       Float
  depreciation_amount Float
  closing_value       Float

  created_at DateTime @default(now())

  asset Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, year])
  @@index([asset_id])
  @@map("asset_depreciation")
}

model AssetLoan {
  id                 String  @id @default(uuid())
  asset_id           String
  borrower_member_id String?

  borrowed_by_name     String?
  loan_date            DateTime        @default(now())
  expected_return_date DateTime
  actual_return_date   DateTime?
  status               AssetLoanStatus @default(borrowed)
  condition_before     AssetCondition?
  condition_after      AssetCondition?
  notes                String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  member Member? @relation(fields: [borrower_member_id], references: [id])
  asset  Asset   @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([asset_id])
  @@index([asset_id, status])
  @@map("asset_loans")
}

model AssetScanLog {
  id            String  @id @default(uuid())
  asset_id      String
  scanned_by_id String?

  scan_type String @default("check") // check, loan, return, maintenance
  metadata  Json   @default("{}")

  created_at DateTime @default(now())

  asset Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([asset_id])
  @@index([asset_id, created_at])
  @@map("asset_scan_logs")
}

// ─── Models: Forms and submissions ───

model Form {
  id        String  @id @default(uuid())
  church_id String
  branch_id String?

  title            String
  description      String?
  fields           Json       @default("[]") // Array of field definitions
  status           FormStatus @default(draft)
  is_template      Boolean    @default(false)
  is_public        Boolean    @default(false)
  public_token     String?    @unique
  unique_field     String? // Field key (e.g. "email") used to detect duplicate public submissions
  submission_limit Int        @default(0) // 0 = unlimited; >0 caps total submissions

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  church      Church           @relation(fields: [church_id], references: [id])
  branch      Branch?          @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  submissions FormSubmission[]

  @@index([church_id, branch_id])
  @@index([church_id, status])
  @@index([church_id, is_template])
  @@map("forms")
}

model FormSubmission {
  id             String  @id @default(uuid())
  church_id      String
  form_id        String
  approved_by_id String?

  data             Json
  submitted_by     String?
  status           SubmissionStatus @default(pending)
  approved_at      DateTime?
  rejection_reason String?
  attachments      Json             @default("[]")

  created_at DateTime @default(now())

  form Form @relation(fields: [form_id], references: [id])

  @@index([form_id])
  @@index([church_id])
  @@index([church_id, status])
  @@map("form_submissions")
}

// ─── Models: Offline synchronization ───

model SyncDevice {
  id        String @id @default(uuid())
  church_id String
  device_id String

  last_pull_cursor DateTime?
  last_seen_at     DateTime  @default(now())

  created_at DateTime @default(now())

  @@unique([church_id, device_id])
  @@index([church_id, last_pull_cursor])
  @@map("sync_devices")
}

model SyncQueue {
  id          String  @id @default(uuid())
  church_id   String
  entity_id   String
  mutation_id String?

  entity    String
  action    String // create, update, delete
  data      Json
  synced    Boolean   @default(false)
  synced_at DateTime?

  created_at DateTime @default(now())

  @@unique([church_id, mutation_id])
  @@index([church_id, created_at, id])
  @@index([synced, created_at])
  @@map("sync_queue")
}

// Durable acknowledgements are independent of the expiring change feed.
model OfflineReceipt {
  id          String @id @default(uuid())
  church_id   String
  profile_id  String
  mutation_id String

  payload_hash String
  result       Json

  created_at DateTime @default(now())

  @@unique([church_id, profile_id, mutation_id])
  @@map("offline_receipts")
}

// ─── Models: Audit and outgoing webhooks ───

model AuditLog {
  id        String  @id @default(uuid())
  church_id String
  user_id   String?
  entity_id String?

  action     String
  entity     String
  old_values Json?
  new_values Json?
  ip_address String?
  user_agent String?

  created_at DateTime @default(now())

  church Church @relation(fields: [church_id], references: [id])

  @@index([church_id, created_at])
  @@index([entity, entity_id])
  @@map("audit_logs")
}

model WebhookSubscription {
  id        String @id @default(uuid())
  church_id String

  url       String
  events    String[] // e.g. ["member.created", "transaction.completed"]
  secret    String
  is_active Boolean  @default(true)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime? // Set when archived

  @@index([church_id, is_active])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id              String @id @default(uuid())
  subscription_id String

  event           String
  payload         Json
  status          String    @default("pending") // pending, success, failed
  response_status Int?
  response_body   String?
  attempts        Int       @default(0)
  next_retry_at   DateTime?

  created_at DateTime @default(now())

  @@index([subscription_id, status])
  @@map("webhook_deliveries")
}
